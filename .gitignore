# macOS
.DS_Store

# Xcode
*.xcuserstate
# Per-user scheme order and window state. The rule was here all along but did
# nothing for `xcschememanagement.plist`, which had been committed before it
# existed — .gitignore does not apply to tracked files, so Xcode re-dirtied it
# on every open and it rode along in unrelated commits. Untracked (not deleted)
# so the rule finally bites.
xcuserdata/
# Written into the workspace's SHARED data, so the rule above misses it — but its
# contents are per-machine (build-system opt-outs, a derived-data location) and
# ours is an empty dict, which is Xcode saying "I opened this", not a setting.
WorkspaceSettings.xcsettings
DerivedData/
*.xcscmblueprint
*.xccheckout

# Build output. Both release lanes write here and neither was covered: the
# existing Xcode rules catch `.build/` (SPM) and `DerivedData/` by name, but this
# tree is at the repo root and named neither.
#   build/release/       scripts/release.sh — xcarchive, export, DMG, appcast
#   build/local-release/ scripts/run-local.command — derived data + the .app
# Multiple GB of untracked artifacts, one `git add .` away from the history.
/build/

# Chrome extension packaging output (scripts/package-extension.sh)
/dist/

# Swift Package Manager
.build/
.swiftpm/
# Package.resolved is committed (pins GRDB) for reproducible app/CI builds.

# Raw platform captures (real personal data) used to derive sanitized test
# fixtures. Never commit these — the sanitized versions live in
# extension/test/fixtures/. See extension/test/fixtures/README.md.
/resources/
# A stray raw capture at the repo root (belongs in /resources/) — ignored so real
# bookmark data can't be committed by accident.
/twitter-bookmark-folder-response.json

# Vendored reference apps read for comparison (e.g. Nook), not part of the build.
# ~10 MB of third-party source that sat untracked in every `git status`, one
# `git add .` away from being committed into this repo's history.
/ref/

# Tier-3 T0 probe (096 § T0) — a measurement instrument, deleted when T0 is answered.
# The staging dir is a manifest plus a SYMLINK to extension/src (never a copy — 404), and
# the Xcode project is converter output, regenerable in one command. Neither is source.
/tier3-probe-stage/
/tier3-probe-xcode/
