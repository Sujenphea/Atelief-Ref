<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!--
	  008 · H4 — off-device backup to a user-chosen folder. The picker grant
	  above lasts only for this process; reaching the SAME folder on a later
	  launch (the whole point of a recurring backup) requires a security-scoped
	  bookmark, which is what app-scope enables. See `FolderAccess.swift`.
	  App-scope (not document-scope): the target belongs to the app, not to a
	  document the user opened.
	-->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!--
	  052 · A3 (decision 2A) — Sparkle sandboxed auto-update. The host app talks to
	  Sparkle's Installer/Downloader XPC services (embedded in Sparkle.framework)
	  over per-app mach service names Sparkle derives from the bundle id:
	  `<bundle-id>-spks` (status/progress) and `<bundle-id>-spki` (installer).
	  $(PRODUCT_BUNDLE_IDENTIFIER) is substituted at build time to
	  `sujenphea.AtelierRefs`. These temporary-exception entitlements are the ONLY
	  additions Sparkle's sandboxing guide requires of the host; app-sandbox,
	  network.client, network.server and files.user-selected above are unchanged.
	-->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
</dict>
</plist>
